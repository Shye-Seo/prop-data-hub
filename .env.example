# --- API ---
PORT=8080
# PostgreSQL 접속 문자열. 비워 두면 인메모리 리포지토리로 기동한다(로컬 데모·테스트용).
DATABASE_URL=postgres://prop:prop@localhost:5432/prop_data_hub
# 프론트엔드 데모에서 API를 직접 호출할 때 사용. 비워 두면 번들 내 샘플 데이터를 쓴다.
CORS_ORIGIN=http://localhost:5173

# --- 수집 파이프라인 ---
# 공공데이터포털(data.go.kr) 국토교통부 아파트 매매 실거래가 서비스 인증키(Decoding 키)
MOLIT_SERVICE_KEY=
# 한국은행 ECOS Open API 인증키
ECOS_API_KEY=
MOLIT_DAILY_QUOTA=10000
MOLIT_REQUESTS_PER_SECOND=5
COLLECTOR_TRIGGER=manual
